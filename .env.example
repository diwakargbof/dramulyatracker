# Anthropic API — for Claude-powered calorie analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Turso (cloud SQLite) — leave blank to use local SQLite file instead
# Get these from: https://turso.tech  →  create a database → get URL + token
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Server port (optional, defaults to 3000)
PORT=3000
